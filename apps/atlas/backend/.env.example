# Atlas backend — copy to .env and fill in. Never commit .env.
ATLAS_ENV=production
# REQUIRED in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
ATLAS_SECRET_KEY=
ATLAS_DATABASE_URL=sqlite:////data/atlas.db
ATLAS_ACCESS_TOKEN_EXPIRE_MINUTES=720
ATLAS_ALLOW_REGISTRATION=false
ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ATLAS_RATE_LIMIT_PER_MINUTE=300
ATLAS_LOGIN_ATTEMPTS_PER_MINUTE=5
# set to true only if your webhook receiver is on the private network
ATLAS_ALLOW_PRIVATE_WEBHOOKS=false
ATLAS_OWNER_EMAIL=owner@atlas.local
